// SLO Error Budget Analysis
// Track availability against target SLO and calculate remaining error budget.
// Adjust the SLO target and window to match your service objectives.

// --- Configuration ---
let SloTarget = 99.9;          // Target availability percentage
let WindowDays = 30;           // Rolling SLO window
let TotalMinutes = WindowDays * 24 * 60;
//
// --- Availability SLO (based on successful requests) ---
AppRequests
| where TimeGenerated > ago(WindowDays * 1d)
| summarize
    Total = count(),
    Good  = countif(Success == true and toint(ResultCode) < 500)
| extend
    ActualAvailability = round(100.0 * Good / Total, 4),
    SloTargetPct       = SloTarget
| extend
    ErrorBudgetTotalPct   = 100.0 - SloTarget,
    ErrorBudgetUsedPct    = round((100.0 - (100.0 * Good / Total)), 4)
| extend
    ErrorBudgetRemainingPct = round(ErrorBudgetTotalPct - ErrorBudgetUsedPct, 4),
    BudgetConsumedRatio     = round(100.0 * (100.0 - (100.0 * Good / Total)) / (100.0 - SloTarget), 2)
| project
    ActualAvailability,
    SloTargetPct,
    ErrorBudgetTotalPct,
    ErrorBudgetUsedPct,
    ErrorBudgetRemainingPct,
    BudgetConsumedRatio,
    BudgetStatus = case(
        BudgetConsumedRatio >= 100, "EXHAUSTED",
        BudgetConsumedRatio >= 75,  "RED",
        BudgetConsumedRatio >= 50,  "YELLOW",
        "GREEN")

