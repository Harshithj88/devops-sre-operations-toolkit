// Deployment Correlation Analysis
// Correlate deployment events with error rate and performance changes

// --- Error rate before vs after deployment (replace timestamp) ---
let deployTime = datetime(2024-01-15T14:00:00Z);
let windowHours = 2;
AppRequests
| where TimeGenerated between (deployTime - windowHours*1h .. deployTime + windowHours*1h)
| summarize
    TotalRequests = count(),
    FailedRequests = countif(Success == false),
    ErrorRate = round(100.0 * countif(Success == false) / count(), 2),
    AvgDurationMs = round(avg(DurationMs), 1)
    by bin(TimeGenerated, 5m), Phase = iff(TimeGenerated < deployTime, "Before", "After")
| order by TimeGenerated asc

